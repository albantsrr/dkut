# Variables lues par `docker compose -f docker-compose.prod.yml` lui-même
# (pas par l'app — distinct de .env et de server/.env).
# Usage : cp .env.prod.example .env.prod, puis
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# Mot de passe du service postgres du compose de prod. Doit être IDENTIQUE
# au mot de passe utilisé dans DATABASE_URL de server/.env (ex:
# postgres://bibliotheque:<CE_MOT_DE_PASSE>@postgres:5432/bibliotheque) —
# rien ne les synchronise automatiquement, les deux fichiers doivent être
# tenus à jour ensemble à la main.
POSTGRES_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────
# Attention, fichier DIFFÉRENT de celui-ci : le .env À LA RACINE (pas
# .env.prod) est ce que le Dockerfile racine copie (COPY . .) et que Vite lit
# au moment du `npm run build` dans l'image frontend. Avant de builder pour
# la prod, ce .env racine doit contenir :
#   VITE_GOOGLE_CLIENT_ID=<même client OAuth qu'en dev>
#   VITE_API_URL=/api
# (chemin relatif — Nginx proxy /api/* vers le backend, voir nginx/nginx.conf)
# et PAS VITE_API_URL=http://localhost:8787 (valeur de dev). Remettre la
# valeur de dev après le build si tu continues à développer en local sur la
# même machine.
