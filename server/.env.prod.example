# Variables pour server/.env en prod (Docker Compose), à distinguer de
# .env.example (dev local, Postgres sur l'hôte via localhost:5433).
# Usage : cp server/.env.prod.example server/.env, remplir les valeurs.

PORT=8787

# Host "postgres" = nom du service Docker Compose (docker-compose.prod.yml),
# résolu via le réseau Docker interne — jamais localhost en conteneur.
# Le mot de passe doit être IDENTIQUE à POSTGRES_PASSWORD dans .env.prod
# (racine) — rien ne les synchronise automatiquement.
DATABASE_URL=postgres://bibliotheque:<MEME_MOT_DE_PASSE_QUE_.env.prod>@postgres:5432/bibliotheque

GEMINI_API_KEY=

# Chemin interne au conteneur — mappé sur le volume bibliotheque-files
# (voir docker-compose.prod.yml), jamais ./data en prod.
STORAGE_DIR=/app/data

GOOGLE_CLIENT_ID=

# openssl rand -base64 48
SESSION_SECRET=

# Domaine HTTPS réel servant le frontend (pas localhost:5173 en prod).
CORS_ORIGIN=https://dkut.online
