PORT=8787

DATABASE_URL=postgres://bibliotheque:bibliotheque@localhost:5433/bibliotheque

# Gemini API key (ai.google.dev) — never exposed to the browser. All
# @google/generative-ai calls now live here (see server/src/gemini.js); the
# frontend's VITE_GEMINI_API_KEY is gone.
GEMINI_API_KEY=

# Where EPUB files and extracted covers are written. Defaults to ./data
# (relative to the server process's cwd) if unset — fine for local dev, but
# set this to a persisted volume path on the VPS.
STORAGE_DIR=./data

# Same OAuth 2.0 client ID as the frontend's VITE_GOOGLE_CLIENT_ID — the
# access token's aud/azp (per Google's tokeninfo endpoint) must match this.
GOOGLE_CLIENT_ID=

# Signs the session JWT. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Origin(s) allowed to send credentialed requests (comma-separated).
CORS_ORIGIN=http://localhost:5173
